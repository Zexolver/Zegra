{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zegra",
  "version": "0.1.0",
  "identifier": "com.zexolver.zegra",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Zegra",
        "width": 1280,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["nxm"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "Game",
    "shortDescription": "The ultimate game launcher",
    "longDescription": "Zegra combines game libraries from Steam, GOG, Epic (via Legendary/Heroic), and itch.io into a single lightweight launcher."
  }
}
