{
    "build": {
      "beforeBuildCommand": "",
      "beforeDevCommand": "",
      "devPath": "../frontend",        /* When running `tauri dev` */
      "distDir": "../frontend"         /* When building for production */
    },
    "package": {
      "productName": "Zegra",
      "version": "0.1.0"
    },
    "tauri": {
      "windows": [
        {
          "title": "Zegra",
          "width": 1280,
          "height": 720,
          "resizable": true,
          "fullscreen": false
        }
      ],
      "security": {
        "csp": null
      },
      "allowlist": {
        "all": true
      },
      "bundle": {
        "identifier": "com.yourname.zegra",
        "icon": [
          "icons/icon.icns",
          "icons/icon.ico",
          "icons/icon.png"
        ],
        "resources": [],
        "externalBin": [],
        "macOS": {
          "entitlements": null,
          "exceptionDomain": "",
          "signingIdentity": null
        },
        "windows": {
          "certificateThumbprint": null,
          "digestAlgorithm": "sha256",
          "timestampUrl": ""
        },
        "linux": {
          "category": "Utility"
        }
      }
    }
  }
  